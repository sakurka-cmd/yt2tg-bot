[Unit]
Description=yt2tg — YouTube to VideoHost Telegram Bot
After=network.target

[Service]
Type=simple
User=userv
WorkingDirectory=/home/userv/yt2tg-bot
ExecStart=/home/userv/yt2tg-bot/venv/bin/python -m bot.main
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/userv/yt2tg-bot/.env

[Install]
WantedBy=default.target