TG_BOT_TOKEN=your-telegram-bot-token
VIDEOHOST_URL=http://127.0.0.1:3002
VIDEOHOST_TOKEN=your-videohost-bot-token
ADMIN_IDS=
CHECK_INTERVAL=3600
LOG_LEVEL=INFO
DATABASE_URL=data/yt2tg_bot.db
TMP_DIR=/tmp/yt2tg
MAX_FILE_SIZE=0
# Cookies (Netscape format) from a logged-in YouTube account — needed only
# for age-restricted videos ("Sign in to confirm your age"). Leave empty
# if you don't need those; see README section "Cookies / возрастные видео".
# YTDLP_COOKIES=/opt/yt2tg-bot/cookies.txt
